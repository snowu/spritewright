{
  "name": "spritewright",
  "version": "0.1.0",
  "description": "A dependency-free pixel art editor that finds the sprites in a project, saves them back, and can open a pull request with the changes.",
  "type": "module",
  "bin": {
    "spritewright": "bin/spritewright.mjs"
  },
  "main": "index.mjs",
  "files": [
    "spritewright.js",
    "index.mjs",
    "index.d.ts",
    "index.html",
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "worker"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs test/worker.test.mjs test/create-app.test.mjs test/pr-api.test.mjs test/install.test.mjs test/mcp.test.mjs",
    "e2e": "node test/e2e.mjs",
    "playground": "node bin/spritewright.mjs examples/playground --open",
    "test:pack": "node test/pack.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./spritewright.js": "./spritewright.js",
    "./scan": "./src/scan.mjs",
    "./serve": "./src/serve.mjs",
    "./mcp": "./src/mcp.mjs",
    "./package.json": "./package.json"
  },
  "keywords": [
    "pixel-art",
    "sprite",
    "editor",
    "gamedev",
    "png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowu/spritewright.git"
  },
  "homepage": "https://github.com/snowu/spritewright#readme",
  "bugs": {
    "url": "https://github.com/snowu/spritewright/issues"
  }
}
